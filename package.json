{
  "name": "timekast-starter-kit",
  "version": "2.2.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "node scripts/tools/dev.mjs",
    "dev:next": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "update-board": "tsx scripts/tools/update-board.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx scripts/e2e-isolated.ts",
    "test:e2e:ui": "playwright test --ui",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "env:check": "node -e \"require('./lib/env.ts')\" 2>/dev/null || echo '⚠️  Run with tsx: pnpm tsx -e \"import { getEnv } from \\\"./lib/env\\\"; getEnv();\"'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --require dotenv/config lib/db/seed.ts dotenv_config_path=.env.local",
    "db:seed:admin": "tsx --require dotenv/config lib/db/seeds/admin.ts dotenv_config_path=.env.local",
    "prepare": "husky",
    "pwa:check": "echo 'Starting Lighthouse PWA audit...' && npx lighthouse http://localhost:3000 --only-categories=pwa --output=html --output-path=./lighthouse-pwa.html && echo 'Report saved to lighthouse-pwa.html'",
    "setup:e2e": "tsx scripts/tools/setup-e2e.ts",
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect --url=http://localhost:3000",
    "lighthouse:assert": "lhci assert",
    "generate:inventory": "node scripts/tools/generate-inventory.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.1",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@headlessui/react": "^2.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.36.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "resend": "^6.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.19.30",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.4",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md}": [
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@auth/core>nodemailer": "^7.0.12",
      "esbuild": ">=0.25.0",
      "@isaacs/brace-expansion": ">=5.0.1",
      "tmp": ">=0.2.4"
    }
  }
}
